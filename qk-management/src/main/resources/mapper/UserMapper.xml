<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.itcast.mapper.UserMapper">

    <select id="findByUsername" resultType="cn.itcast.pojo.User">
        select  user.*, role.label roleLabel
        from user
        left join role on user.role_id = role.id
        <where>
            username = #{username}
        </where>
    </select>

    <!--根据角色描述查询用户-->
    <select id="findByRoleLabel" resultType="cn.itcast.pojo.User">

        select user.*
        from user
                 left join role on user.role_id = role.id
        where role.label = #{roleLabel}
    </select>

    <!--分页条件查询用户以及对应的部门和角色-->

    <select id="findByPageAndCondition" resultType="cn.itcast.pojo.User">
        select user.*, dept.name as deptName, role.name as roleName
        from user
        left join dept on user.dept_id = dept.id
        left join role on user.role_id = role.id
        <where>
            <if test="userDTO.name !=null and userDTO.name !=''">
                name like concat('%', #{userDTO.name}, '%')
            </if>
            <if test="userDTO.status !=null ">
                and user.status = #{userDTO.status}
            </if>
            <if test="userDTO.phone !=null and userDTO.phone !=''">
                and phone like concat('%', #{userDTO.phone}, '%')
            </if>
            <if test="userDTO.deptId !=null ">
                and dept_id = #{userDTO.deptId}
            </if>
        </where>

    </select>
